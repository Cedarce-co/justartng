# Postgres connection string (Supabase, Neon, or Vercel Postgres).
# Without it, registrations are saved to data/registrations.json on this machine.
DATABASE_URL=

# Resend. Both values are required before a confirmation email is sent.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Where to email collector interests from the 3D studio (uses the Resend values above).
# Interests are always saved and listed at /admin/registrations, even without this.
COLLECT_NOTIFY_EMAIL=

# WhatsApp alerts for collector interests. Set the number, plus ONE of the keys below.
#
# TextMeBot (https://textmebot.com): free 2-day demo, then about $1/month for alerts to yourself.
# Request a key on the site; it arrives by email with links to add and link your WhatsApp number.
TEXTMEBOT_API_KEY=
#
# Or CallMeBot (https://www.callmebot.com), free but for personal use only.
# Activate once: save +34 644 51 95 23 as a contact, then from this number send
# "I allow callmebot to send me messages" on WhatsApp. It replies with your API key
# within about 2 minutes; if not, try again after 24 hours.
# Note: CallMeBot's free API is for personal use only.
WHATSAPP_NOTIFY_NUMBER=
CALLMEBOT_API_KEY=

# Password for /admin/registrations
ADMIN_PASSWORD=

# Public site URL used for metadata. Example: https://example.com
NEXT_PUBLIC_SITE_URL=
