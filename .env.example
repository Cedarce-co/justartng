# Postgres connection string (Supabase, Neon, or Vercel Postgres).
# Without it, registrations are saved to data/registrations.json on this machine.
DATABASE_URL=

# Resend. Both values are required before a confirmation email is sent.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Where to email collector interests from the 3D studio (uses the Resend values above).
# Interests are always saved and listed at /admin/registrations, even without this.
COLLECT_NOTIFY_EMAIL=

# Password for /admin/registrations
ADMIN_PASSWORD=

# Public site URL used for metadata. Example: https://example.com
NEXT_PUBLIC_SITE_URL=
